# Maintainer: Danil Zorin <45851636+Pisosenie@users.noreply.github.com>
pkgname=vif-git
_name=vif
pkgver=r0
pkgrel=1
pkgdesc='A fast GPU terminal, set up in a window with a live preview or in a file'
arch=('x86_64' 'aarch64')
url='https://github.com/Pisosenie/vif'
license=('MIT OR Apache-2.0')
depends=('fontconfig' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
optdepends=(
  'vulkan-driver: GPU rendering; without one vif falls back to OpenGL'
  'libx11: running under X11'
)
makedepends=('cargo' 'git' 'ncurses')
provides=("$_name")
conflicts=("$_name")
source=("$_name::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p vif -p vif-settings
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}

package() {
  cd "$_name"
  install -Dm755 target/release/vif "$pkgdir/usr/bin/vif"
  install -Dm755 target/release/vif-settings "$pkgdir/usr/bin/vif-settings"
  install -dm755 "$pkgdir/usr/share/terminfo"
  tic -x -o "$pkgdir/usr/share/terminfo" assets/xterm-vif.terminfo
  install -Dm644 assets/vif.desktop "$pkgdir/usr/share/applications/vif.desktop"
  install -Dm644 assets/vif.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vif.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-GEIST"
}
