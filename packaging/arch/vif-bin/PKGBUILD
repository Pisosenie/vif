# Maintainer: Danil Zorin <45851636+Pisosenie@users.noreply.github.com>
pkgname=vif-bin
pkgver=0.1.2
pkgrel=1
pkgdesc='A fast GPU terminal with themes, command blocks and shells that outlive the window (prebuilt)'
arch=('x86_64' 'aarch64')
url='https://github.com/Pisosenie/vif'
license=('MIT OR Apache-2.0')
depends=('glibc' 'libgcc' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'libglvnd' 'fontconfig' 'hicolor-icon-theme')
optdepends=(
  'vulkan-driver: drawing through Vulkan; without one vif draws through OpenGL'
  'opengl-driver: drawing through OpenGL where there is no Vulkan'
  'libx11: running under X11'
  'libxcursor: running under X11'
  'libxi: running under X11'
  'libxrandr: running under X11'
  'libxkbcommon-x11: running under X11'
)
makedepends=('ncurses')
provides=('vif')
conflicts=('vif')
options=('!debug' '!strip')
source=("xterm-vif-$pkgver.terminfo::https://raw.githubusercontent.com/Pisosenie/vif/v$pkgver/assets/xterm-vif.terminfo")
source_x86_64=("$url/releases/download/v$pkgver/vif-$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/vif-$pkgver-aarch64-linux.tar.gz")
sha256sums=('dea446dfd1b4eda84fc89bd6d2c805dc11c575c2f2370d4a14ae59cab6a0090c')
sha256sums_x86_64=('99d95341648571eef56de1bd2e33ceb683fc71d0784bb6750aed8eb5b398ce2b')
sha256sums_aarch64=('d9a6ad0ffd400c637f895f662d62cdae2a2a1e6d829a0b0064cf87b90903a28c')

package() {
  cd "vif-$pkgver-$CARCH-linux"
  install -Dm755 vif "$pkgdir/usr/bin/vif"
  install -Dm755 vif-settings "$pkgdir/usr/bin/vif-settings"
  install -dm755 "$pkgdir/usr/share/terminfo"
  tic -x -o "$pkgdir/usr/share/terminfo" "$srcdir/xterm-vif-$pkgver.terminfo"
  install -Dm644 vif.desktop "$pkgdir/usr/share/applications/vif.desktop"
  install -Dm644 vif.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vif.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/vif/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 OFL-GEIST.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-GEIST"
}
